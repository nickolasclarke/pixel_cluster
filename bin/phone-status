#!/usr/bin/env bash
# phone-status — one line per adb-attached phone: installed vs pinned APK versions, tailnet
# state of the guest node and of the phone's own Android node, Dokploy server status. Exit 1 if any phone is behind a pin or missing a piece.
#
# Usage: bin/phone-status
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck disable=SC1091
source bin/lib.sh

TS_JSON=$(mktemp); SERVERS=$(mktemp); trap 'rm -f "$TS_JSON" "$SERVERS"' EXIT
tailscale status --json > "$TS_JSON" 2>/dev/null || echo '{}' > "$TS_JSON"
dk_get server.all > "$SERVERS" 2>/dev/null || echo '[]' > "$SERVERS"
rc=0; SEEN=""
for target in $(adb devices | awk 'NR>1 && $2=="device" {print $1}'); do
  serial=$(adb_real_serial "$target"); [ -n "$serial" ] || continue
  case " $SEEN " in *" $serial "*) continue ;; esac; SEEN="$SEEN $serial"   # one line per phone even if on USB and Wi-Fi
  model=$(adb -s "$target" shell getprop ro.product.model | tr -d '\r')
  name=$(phone_node_name "$model" "$serial" pins/phones)
  line="$serial $model via:$target"
  while read -r app pkg <&3; do
    inst=$(parse_version_name "$(adb -s "$target" shell dumpsys package "$pkg" 2>/dev/null)")
    pin=$(cat "pins/$app.version" 2>/dev/null || echo '?')
    line="$line $app:${inst:-none}/$pin"
    [ "$(version_matches_pin "${inst:-none}" "$pin")" = yes ] || rc=1
  done 3< pins/packages
  charge=$(charge_limit_label "$(adb -s "$target" shell settings get secure charge_optimization_mode | tr -d '\r')"); [ "$charge" = "80%" ] || rc=1
  node=$(node_state "$TS_JSON" "$name"); [ "$node" = online ] || rc=1
  anode=$(node_state "$TS_JSON" "${name%-podroid}"); [ "$anode" = online ] || rc=1   # Tailscale app: adb off USB
  sid=$(find_server_id "$SERVERS" "$name")
  if [ -n "$sid" ]; then dk=$(python3 -I -c 'import sys,json; print([s for s in json.load(open(sys.argv[1])) if s["serverId"]==sys.argv[2]][0].get("serverStatus"))' "$SERVERS" "$sid"); else dk=none; rc=1; fi
  echo "$line charge:$charge node:$node android-node:$anode dokploy:$dk"
done
exit $rc
