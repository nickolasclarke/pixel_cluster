#!/usr/bin/env bash
# phone-provision — take one USB-attached Android phone from "developer mode on" to
# "registered as a Dokploy remote server and validated". Idempotent: every step checks
# before acting, so re-run after a manual step and it continues.
#
# Usage: bin/phone-provision <adb-serial | host:port> [--reinstall]
#   --reinstall   reinstall both APKs even if already present (upgrade path). Over the tailnet this
#                 restarts Tailscale and drops adb mid-install: use USB or the phone's LAN address.
#
# A USB run also turns on network adb (port 5555), which a phone reboot turns off.
# Manual steps it will stop and ask for: Podroid's first-run wizard (device-specific taps),
# and removing a screen lock if one is set (needs the PIN/pattern; see docs/runbook.md §1).
# Needs: adb, ssh, curl, python3, the dokploy CLI logged in, and either
# ~/.config/pixel_cluster/headscale-api-key or ssh access to the DO box (headscale-cn/commands/hs).
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck disable=SC1091
source bin/lib.sh

REINSTALL=0; SERIAL=""; APK_DIR=${APK_DIR:-apks}
for a in "$@"; do case "$a" in --reinstall) REINSTALL=1 ;; -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; *) SERIAL=$a ;; esac; done
[ -n "$SERIAL" ] || die "usage: bin/phone-provision <adb-serial | host:port>"
adb -s "$SERIAL" get-state >/dev/null 2>&1 || die "adb cannot see $SERIAL (unauthorized, unplugged, or not connected over the network?)"
ADB_TARGET=$SERIAL; SERIAL=$(adb_real_serial "$ADB_TARGET"); [ -n "$SERIAL" ] || die "cannot read the phone's serial via $ADB_TARGET"

HS_USER_ID=1   # headscale user "nick"
HS_URL="https://hs.nclar.ke"; HS_KEYFILE="$HOME/.config/pixel_cluster/headscale-api-key"; HS_CMD="$HOME/repos/headscale-cn/commands/hs"
DOKPLOY_SSHKEY_ID="46etDVagTkjFQka2nEbhV"
MODEL=$(adb -s "$ADB_TARGET" shell getprop ro.product.model | tr -d '\r')
NAME=$(phone_node_name "$MODEL" "$SERIAL" pins/phones)
step() { echo "== $*"; log "$*"; }

# 1. APKs ----------------------------------------------------------------------------------
step "1 apks ($MODEL, node name $NAME)"
while read -r app pkg <&3; do
  pin=$(cat "pins/$app.version" 2>/dev/null) || die "no pins/$app.version (run bin/apk-fetch)"
  apk=$(find "$APK_DIR" -maxdepth 1 -iname "${app}*${pin#v}*.apk" -printf '%f\n' | head -1); [ -n "$apk" ] || die "no $app $pin APK in $APK_DIR/ (run bin/apk-fetch)"
  if [ "$REINSTALL" = 1 ] || [ -z "$(adb_installed_version "$ADB_TARGET" "$pkg")" ]; then
    if adb -s "$ADB_TARGET" install -r "$APK_DIR/$apk" >>"$LOG_FILE" 2>&1; then echo "   installed $apk"; else die "adb install $apk failed (see $LOG_FILE)"; fi
  else echo "   $pkg already installed (versionCode $(adb_installed_version "$ADB_TARGET" "$pkg"))"; fi
done 3< pins/packages

# 2. Phone settings (all idempotent) -------------------------------------------------------
step "2 phone settings"
# network adb on :5555 so the phone stays reachable off USB; before step 3, since it restarts adbd
NET_ADB=$(adb_network_enable "$ADB_TARGET" 5555) || die "adb tcpip 5555 failed on $ADB_TARGET"
[ -z "$NET_ADB" ] || echo "   $NET_ADB"
PODROID_PKG=$(awk '$1=="podroid"{print $2}' pins/packages)
adb -s "$ADB_TARGET" shell device_config set_sync_disabled_for_tests persistent
adb -s "$ADB_TARGET" shell device_config put activity_manager max_phantom_processes 2147483647
adb -s "$ADB_TARGET" shell settings put global settings_enable_monitor_phantom_procs false
for p in POST_NOTIFICATIONS MANAGE_VIRTUAL_MACHINE USE_CUSTOM_VIRTUAL_MACHINE; do adb -s "$ADB_TARGET" shell pm grant "$PODROID_PKG" "android.permission.$p" 2>>"$LOG_FILE" || true; done
adb -s "$ADB_TARGET" shell dumpsys deviceidle whitelist "+$PODROID_PKG" >>"$LOG_FILE"
# background survival beyond the deviceidle whitelist: run-in-background app ops, active standby
# bucket, no app hibernation / permission auto-revoke. Verified under forced deep Doze (runbook).
adb -s "$ADB_TARGET" shell appops set "$PODROID_PKG" RUN_ANY_IN_BACKGROUND allow
adb -s "$ADB_TARGET" shell appops set "$PODROID_PKG" RUN_IN_BACKGROUND allow
adb -s "$ADB_TARGET" shell am set-standby-bucket "$PODROID_PKG" active
adb -s "$ADB_TARGET" shell cmd app_hibernation set-state --user 0 "$PODROID_PKG" false >>"$LOG_FILE" 2>&1 || true
adb -s "$ADB_TARGET" shell appops set "$PODROID_PKG" AUTO_REVOKE_PERMISSIONS_IF_UNUSED ignore >>"$LOG_FILE" 2>&1 || true
# screen off by default (wake with `adb shell input keyevent KEYCODE_WAKEUP` when driving the UI)
adb -s "$ADB_TARGET" shell svc power stayon false
adb -s "$ADB_TARGET" shell settings put system screen_off_timeout 60000
adb -s "$ADB_TARGET" shell settings put system screen_brightness_mode 0
adb -s "$ADB_TARGET" shell settings put system screen_brightness 1
if [ "$(adb -s "$ADB_TARGET" shell locksettings get-disabled | tr -d '\r')" != "true" ]; then
  adb -s "$ADB_TARGET" shell locksettings set-disabled true >>"$LOG_FILE" 2>&1 || true
  [ "$(adb -s "$ADB_TARGET" shell locksettings get-disabled | tr -d '\r')" = "true" ] || \
    echo "   NOTE: a PIN/pattern is set; clear it once with: adb -s $ADB_TARGET shell locksettings clear --old <PIN>"
fi
# charge to 80 % only: the phone lives on power (Battery > Battery health > Charging optimization)
adb -s "$ADB_TARGET" shell settings put secure charge_optimization_mode 1
adb -s "$ADB_TARGET" shell settings put secure adaptive_charging_enabled 0
echo "   phantom-process fix, Podroid permissions and background ops, screen off after 60 s, charge limit 80%"
DEBLOAT_OUT=$(bin/phone-debloat "$ADB_TARGET") || die "phone-debloat failed (see $LOG_FILE)"
echo "   debloat: ${DEBLOAT_OUT%%$'\n'*}"

# 3. VM up and reachable on 9922 through an adb forward -------------------------------------
step "3 Podroid VM"
# host port is per phone (adb allocates), so several attached phones never collide on 9922
LOCAL_PORT=$(adb -s "$ADB_TARGET" forward tcp:0 tcp:9922)
vm_up() { timeout 4 bash -c "exec 3<>/dev/tcp/127.0.0.1/$LOCAL_PORT && head -c 7 <&3" 2>/dev/null | grep -q SSH; }
if ! vm_up; then
  adb -s "$ADB_TARGET" shell am start -a com.excp.podroid.action.START_VM >>"$LOG_FILE" 2>&1 || true
  for _ in $(seq 1 36); do vm_up && break; sleep 5; done
fi
if ! vm_up; then
  cat <<MSG
   The VM is not answering on guest port 22 (dropbear, via adb forward $LOCAL_PORT). If this is the phone's first run, finish Podroid's wizard on
   the phone (docs/runbook.md §2: load balance OFF, largest disk leaving Android ~10 GB, 4 GB RAM,
   top core count, Unlimited, SSH ON),
   then switch on Settings > Start VM on boot, start the VM, and re-run this script.
MSG
  exit 2
fi
echo "   dropbear answering (adb forward $LOCAL_PORT -> 9922)"
# Podroid does not restart its VM after Android kills the app; phone/podroid-watchdog does (runbook).
# It runs detached as adb's shell user and is lost on a phone reboot, so every run re-checks it.
WD=/data/local/tmp/podroid-watchdog
if [ "$(adb -s "$ADB_TARGET" shell "md5sum $WD 2>/dev/null" | cut -d' ' -f1)" != "$(md5sum < phone/podroid-watchdog | cut -d' ' -f1)" ] \
   || ! adb -s "$ADB_TARGET" shell "kill -0 \$(cat $WD.pid 2>/dev/null) 2>/dev/null"; then
  adb -s "$ADB_TARGET" shell "kill \$(cat $WD.pid 2>/dev/null) 2>/dev/null" || true
  adb -s "$ADB_TARGET" push phone/podroid-watchdog "$WD" >>"$LOG_FILE"
  adb -s "$ADB_TARGET" shell "setsid nohup sh $WD </dev/null >/dev/null 2>&1 &"
  sleep 2
fi
adb -s "$ADB_TARGET" shell "kill -0 \$(cat $WD.pid 2>/dev/null) 2>/dev/null" || die "podroid-watchdog did not start on the phone (see $LOG_FILE)"
echo "   podroid-watchdog running (restarts the VM if Android kills Podroid)"

# 4. Guest shell access: operator key, else first-boot password --------------------------------
SSH_OPTS=(-p "$LOCAL_PORT" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR)
ASKPASS=$(mktemp); printf '#!/bin/sh\necho podroid\n' > "$ASKPASS"; chmod +x "$ASKPASS"; trap 'rm -f "$ASKPASS"; adb -s "$ADB_TARGET" forward --remove "tcp:$LOCAL_PORT" >/dev/null 2>&1' EXIT
gsh() { # run a command in the guest
  if ssh "${SSH_OPTS[@]}" -o BatchMode=yes root@127.0.0.1 true </dev/null 2>/dev/null; then ssh "${SSH_OPTS[@]}" -o BatchMode=yes root@127.0.0.1 "$@"
  else SSH_ASKPASS="$ASKPASS" SSH_ASKPASS_REQUIRE=force ssh "${SSH_OPTS[@]}" -o PreferredAuthentications=password root@127.0.0.1 "$@"; fi
}

# 5. Guest configuration (one idempotent remote script) --------------------------------------
step "5 guest packages, sshd:$GUEST_SSH_PORT, keys, cron, forwards"
DOKPLOY_PUB=$(dk_get sshKey.all | python3 -I -c 'import sys,json; print([k for k in json.load(sys.stdin) if k["sshKeyId"]==sys.argv[1]][0]["publicKey"].strip())' "$DOKPLOY_SSHKEY_ID")
OPERATOR_PUB=$(cat ~/.ssh/id_ed25519.pub 2>/dev/null || cat ~/.ssh/id_rsa.pub 2>/dev/null) || die "no ~/.ssh/id_ed25519.pub or id_rsa.pub: the operator key is installed in every guest"
KEEPALIVE_B64=$(base64 -w0 guest/tailnet-keepalive)
DAEMON_JSON=$(docker_daemon_json_overlay2 "$(gsh "cat /etc/docker/daemon.json 2>/dev/null" </dev/null)")
FORWARDS=$(awk '{printf "/usr/local/bin/podroid-forward list | grep -q \"^%s %s %s\" || /usr/local/bin/podroid-forward add %s %s %s\n",$1,$2,$3,$1,$2,$3}' pins/forwards)
gsh "bash -sx" 2>>"$LOG_FILE" <<GUEST || die "guest configuration failed (see $LOG_FILE)"
set -e
grep -q mirrors.aliyun.com /etc/apk/repositories || sed -i 's#https://dl-cdn.alpinelinux.org#https://mirrors.aliyun.com#g' /etc/apk/repositories
command -v tailscale >/dev/null && command -v sshd >/dev/null || { apk update >/dev/null; apk add tailscale openssh-server >/dev/null; }
mkdir -p /etc/ssh/sshd_config.d /root/.ssh; chmod 700 /root/.ssh; touch /root/.ssh/authorized_keys; chmod 600 /root/.ssh/authorized_keys
grep -qF '$DOKPLOY_PUB' /root/.ssh/authorized_keys || echo '$DOKPLOY_PUB' >> /root/.ssh/authorized_keys
grep -qF '$OPERATOR_PUB' /root/.ssh/authorized_keys || echo '$OPERATOR_PUB' >> /root/.ssh/authorized_keys
printf 'Port $GUEST_SSH_PORT\nPermitRootLogin prohibit-password\nPasswordAuthentication no\n' > /etc/ssh/sshd_config.d/dokploy.conf
grep -q '^Include /etc/ssh/sshd_config.d' /etc/ssh/sshd_config || sed -i '1i Include /etc/ssh/sshd_config.d/*.conf' /etc/ssh/sshd_config
ssh-keygen -A >/dev/null 2>&1; rc-update -q add sshd default; rc-service -q sshd restart >/dev/null
sed -i 's#^root:x:0:0:root:/root:/bin/sh#root:x:0:0:root:/root:/bin/bash#' /etc/passwd
# classic overlay2 image store: containerd's snapshotter unpacks hard-linked files as empty here
mkdir -p /etc/docker
if [ "\$(cat /etc/docker/daemon.json 2>/dev/null)" != '$DAEMON_JSON' ]; then
  # images and containers of the old store are gone; step 7 re-runs Dokploy setup when traefik is missing
  echo '$DAEMON_JSON' > /etc/docker/daemon.json; rc-service -q docker restart >/dev/null 2>&1
fi
# tethering hands the guest a global IPv6 address with no route; dockerd then fails pulls over v6
if [ ! -f /etc/sysctl.d/90-no-ipv6.conf ]; then
  printf 'net.ipv6.conf.all.disable_ipv6 = 1\nnet.ipv6.conf.default.disable_ipv6 = 1\n' > /etc/sysctl.d/90-no-ipv6.conf; sysctl -q -p /etc/sysctl.d/90-no-ipv6.conf
  rc-service -q docker restart >/dev/null 2>&1 || true   # dockerd keeps dialing v6 until restarted
fi
grep -q '^DROPBEAR_OPTS="-s"' /etc/conf.d/dropbear || { sed -i 's/^DROPBEAR_OPTS=.*/DROPBEAR_OPTS="-s"/' /etc/conf.d/dropbear; rc-service -q dropbear restart >/dev/null; }
# supervise-daemon's default respawn_max=10 counts over the service's whole lifetime, after which a
# crashed tailscaled stays down for good; respawn forever instead, with a short pause.
grep -q '^respawn_max=' /etc/conf.d/tailscale || { printf '\n# respawn forever (default respawn_max=10 is for the whole service lifetime)\nrespawn_max=0\nrespawn_delay=5\n' >> /etc/conf.d/tailscale; rc-service -q tailscale stop >/dev/null 2>&1 || true; }
rc-update -q add tailscale default; rc-service -q tailscale start >/dev/null 2>&1 || true
# keepalive: keeps the direct UDP path to the DO box warm and re-leases the tether address when the
# box stays unreachable (see guest/tailnet-keepalive); a cron was too slow for the NAT mappings.
crontab -l 2>/dev/null | grep -v 'tailscale ping' | crontab - 2>/dev/null || true
mkdir -p /usr/local/sbin; echo '$KEEPALIVE_B64' | base64 -d > /usr/local/sbin/tailnet-keepalive; chmod +x /usr/local/sbin/tailnet-keepalive
cat > /etc/init.d/tailnet-keepalive <<'RC'
#!/sbin/openrc-run
description="Keep the direct tailnet path to the Dokploy box open and recover the tether address"
command="/usr/local/sbin/tailnet-keepalive"
command_args="$DOKPLOY_BOX_IP"
command_background=yes
pidfile="/run/tailnet-keepalive.pid"
depend() { need tailscale; }
RC
# Dokploy's traefik container dies at boot before the swarm overlay network exists and docker gives up
# on it; start it again once the daemon has settled.
mkdir -p /etc/local.d
printf '#!/bin/sh\n( sleep 45; docker start dokploy-traefik >/dev/null 2>&1 ) &\n' > /etc/local.d/dokploy-traefik.start
chmod +x /etc/local.d/dokploy-traefik.start; rc-update -q add local default
chmod +x /etc/init.d/tailnet-keepalive; rc-update -q add tailnet-keepalive default; rc-service -q tailnet-keepalive restart >/dev/null 2>&1 || rc-service -q tailnet-keepalive start >/dev/null 2>&1
$FORWARDS
echo "   guest configured (\$(tailscale version | head -1), sshd on $GUEST_SSH_PORT, \$(/usr/local/bin/podroid-forward list | wc -l) forwards)"
GUEST

# 6. Join the tailnet ----------------------------------------------------------------------------
step "6 tailnet node $NAME"
if gsh "tailscale status --self 2>/dev/null | grep -q '^100\.'"; then
  gsh "tailscale set --hostname $NAME"; echo "   already joined"
else
  if [ -f "$HS_KEYFILE" ]; then
    # a rebuilt guest (factory reset, Podroid reset) must not leave the old node behind as pixel-x-podroid-1
    NODES=$(mktemp); curl -sf -m 30 -H "Authorization: Bearer $(cat "$HS_KEYFILE")" "$HS_URL/api/v1/node" > "$NODES" || die "cannot list headscale nodes"
    if ! STALE=$(stale_node_id "$NODES" "$NAME" 2>/dev/null); then
      # headscale still says online: a wiped guest never logs out. Settle it with a real ping from this laptop.
      OLD_IP=$(node_ip_by_hostname <(tailscale status --json) "$NAME" 2>/dev/null || true)
      if [ -n "$OLD_IP" ] && tailscale ping -c 1 --timeout 5s "$OLD_IP" >/dev/null 2>&1; then
        die "headscale already has a live, reachable node named $NAME ($OLD_IP)"
      fi
      STALE=$(python3 -I -c 'import json,sys; print([n["id"] for n in json.load(open(sys.argv[1]))["nodes"] if n.get("givenName")==sys.argv[2]][0])' "$NODES" "$NAME")
      echo "   node $NAME is marked online but does not answer; treating it as stale"
    fi
    rm -f "$NODES"
    if [ -n "$STALE" ]; then
      curl -sf -m 30 -X DELETE -H "Authorization: Bearer $(cat "$HS_KEYFILE")" "$HS_URL/api/v1/node/$STALE" >/dev/null || die "could not delete stale node $NAME (id $STALE)"
      echo "   retired stale headscale node $NAME (id $STALE)"
    fi
    KEY=$(curl -sf -m 30 -X POST -H "Authorization: Bearer $(cat "$HS_KEYFILE")" -H 'Content-Type: application/json' \
      -d "{\"user\":\"$HS_USER_ID\",\"reusable\":false,\"ephemeral\":false,\"expiration\":\"$(date -u -d '+1 hour' +%Y-%m-%dT%H:%M:%SZ)\"}" \
      "$HS_URL/api/v1/preauthkey" | python3 -I -c 'import sys,json; print(json.load(sys.stdin)["preAuthKey"]["key"])')
  else
    KEY=$("$HS_CMD" preauthkeys create --user "$HS_USER_ID" --expiration 1h 2>/dev/null | tail -1)
  fi
  [ -n "$KEY" ] || die "could not mint a headscale preauth key (no $HS_KEYFILE and hs via ssh failed)"
  # key travels on stdin into a mode-600 temp file, never on a command line
  printf '%s' "$KEY" | gsh "umask 077; cat > /tmp/.authkey; tailscale up --login-server $HS_URL --authkey file:/tmp/.authkey --hostname $NAME --accept-dns=false; rc=\$?; rm -f /tmp/.authkey; exit \$rc" >>"$LOG_FILE" 2>&1 || die "tailscale up failed in the guest (see $LOG_FILE)"
  echo "   joined"
fi
grep -q "^$SERIAL " pins/phones 2>/dev/null || echo "$SERIAL $NAME" >> pins/phones
TS_JSON=$(mktemp); trap 'rm -f "$ASKPASS" "$TS_JSON"; adb -s "$ADB_TARGET" forward --remove "tcp:$LOCAL_PORT" >/dev/null 2>&1' EXIT
IP=""
for _ in $(seq 1 24); do tailscale status --json > "$TS_JSON" 2>/dev/null; IP=$(node_ip_by_hostname "$TS_JSON" "$NAME" 2>/dev/null) && break; sleep 5; done
[ -n "$IP" ] || die "node $NAME not visible in tailscale status after 2 minutes"
gsh "tailscale ping -c 2 --timeout 5s $DOKPLOY_BOX_IP" >>"$LOG_FILE" 2>&1 || true   # make the guest initiate so the box gets a direct path
echo "   $NAME is $IP"

# 7. Dokploy server record, validate, setup -----------------------------------------------------
step "7 dokploy server"
SERVERS=$(mktemp); dk_get server.all > "$SERVERS"
SID=$(find_server_id "$SERVERS" "$NAME"); rm -f "$SERVERS"
if [ -z "$SID" ]; then
  SID=$(dk_post server.create "{\"name\":\"$NAME\",\"description\":\"$MODEL $SERIAL Podroid guest\",\"ipAddress\":\"$IP\",\"port\":$GUEST_SSH_PORT,\"username\":\"root\",\"sshKeyId\":\"$DOKPLOY_SSHKEY_ID\",\"serverType\":\"deploy\"}" | python3 -I -c 'import sys,json; print(json.load(sys.stdin)["serverId"])')
  echo "   created server $SID"
else
  echo "   server exists: $SID"
  CUR_IP=$(dk_get "server.one?serverId=$SID" | python3 -I -c 'import sys,json; print(json.load(sys.stdin)["ipAddress"])')
  if [ "$CUR_IP" != "$IP" ]; then
    dk_post server.update "{\"serverId\":\"$SID\",\"name\":\"$NAME\",\"description\":\"$MODEL $SERIAL Podroid guest\",\"ipAddress\":\"$IP\",\"port\":$GUEST_SSH_PORT,\"username\":\"root\",\"sshKeyId\":\"$DOKPLOY_SSHKEY_ID\",\"serverType\":\"deploy\"}" >/dev/null
    echo "   updated server IP $CUR_IP -> $IP"
  fi
fi
V=$(dk_get "server.validate?serverId=$SID") || die "dokploy cannot ssh to $IP:$GUEST_SSH_PORT (validate failed)"
if ! dokploy_server_ready "$V"; then
  echo "   running dokploy setup (apk on the China mirror takes minutes)"
  dk_post server.setup "{\"serverId\":\"$SID\"}" >/dev/null || true
  for _ in $(seq 1 90); do sleep 10; dokploy_server_ready "$(dk_get "server.validate?serverId=$SID")" && break; done
  dokploy_server_ready "$(dk_get "server.validate?serverId=$SID")" || die "dokploy setup did not complete; check the server's deployments in Dokploy"
fi
echo "$NAME $IP $SID validated"
echo "log: $LOG_FILE"
