#!/usr/bin/env bash
# apk-fetch — check Tailscale and Podroid official channels for a newer Android APK,
# download it into apks/, verify the vendor-published sha256, and record the version in pins/.
#
# Usage: bin/apk-fetch [--force] [--app tailscale|podroid]
#   --force   download even when pins/<app>.version already matches the vendor's latest
#   --app     only this app (default: both)
# Exit non-zero if any app fails to fetch or verify. Full log path is printed at exit.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck disable=SC1091
source bin/lib.sh

FORCE=0; APPS="tailscale podroid"
while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=1 ;;
    --app) APPS="$2"; shift ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
  shift
done

TS_BASE="https://pkgs.tailscale.com/stable"
PODROID_REPO="ExTV/Podroid"
mkdir -p apks pins

up_to_date() { # app version → 0 if pinned version equals and not --force
  [ "$FORCE" = 0 ] && [ -f "pins/$1.version" ] && [ "$(cat "pins/$1.version")" = "$2" ]
}

fetch_tailscale() {
  local index version asset url expected
  index=$(mktemp); trap 'rm -f "$index"' RETURN
  curl -fsSL "$TS_BASE/" -o "$index" || { echo "cannot fetch $TS_BASE/" >&2; return 1; }
  version=$(tailscale_latest_version "$index") || return 1
  if up_to_date tailscale "$version"; then echo "tailscale up to date ($version)"; return; fi
  asset="tailscale-android-universal-$version.apk"; url="$TS_BASE/$asset"
  expected=$(curl -fsSL "$url.sha256" | cut -d' ' -f1)
  [ ${#expected} -eq 64 ] || { echo "bad sha256 from $url.sha256" >&2; return 1; }
  log "downloading $url"
  download_parts "$url" "apks/$asset" || { echo "download failed: $url" >&2; return 1; }
  verify_sha256 "apks/$asset" "$expected" || return 1
  echo "$version" > pins/tailscale.version
  echo "tailscale $version -> apks/$asset (sha256 ok)"
}

fetch_podroid() {
  local json tag asset expected url
  json=$(mktemp); trap 'rm -f "$json"' RETURN
  gh api "repos/$PODROID_REPO/releases/latest" > "$json" || { echo "cannot fetch $PODROID_REPO latest release" >&2; return 1; }
  read -r tag asset expected < <(podroid_latest "$json") && [ -n "$expected" ] || return 1
  if up_to_date podroid "$tag"; then echo "podroid up to date ($tag)"; return; fi
  url="https://github.com/$PODROID_REPO/releases/download/$tag/$asset"
  log "downloading $url"
  download_parts "$url" "apks/$asset" || { echo "download failed: $url" >&2; return 1; }
  verify_sha256 "apks/$asset" "$expected" || return 1
  echo "$tag" > pins/podroid.version
  echo "podroid $tag -> apks/$asset (sha256 ok)"
}

rc=0
for app in $APPS; do
  case "$app" in
    tailscale) fetch_tailscale || rc=1 ;;
    podroid) fetch_podroid || rc=1 ;;
    *) die "unknown app: $app" ;;
  esac
done
echo "log: $LOG_FILE"
exit $rc
